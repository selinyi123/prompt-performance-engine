{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-performance-engine:schema:frontier:source-commitment:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_id", "case_commitments",
    "license_review_path", "license_review_sha256",
    "exclusion_rules_path", "exclusion_rules_sha256",
    "contamination_check_path", "contamination_check_sha256",
    "target_distribution_path", "target_distribution_sha256",
    "utility_anchors_path", "utility_anchors_sha256",
    "power_analysis_path", "power_analysis_sha256", "minimum_calibration_cases",
    "robustness_pairs", "analysis_sha256", "sealed_access_policy_path",
    "sealed_access_policy_sha256", "sealed_content_disclosed", "commitment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"$ref": "#/$defs/identifier"},
    "case_commitments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/caseCommitment"}},
    "license_review_path": {"$ref": "#/$defs/relativePath"}, "license_review_sha256": {"$ref": "#/$defs/sha256"},
    "exclusion_rules_path": {"$ref": "#/$defs/relativePath"}, "exclusion_rules_sha256": {"$ref": "#/$defs/sha256"},
    "contamination_check_path": {"$ref": "#/$defs/relativePath"}, "contamination_check_sha256": {"$ref": "#/$defs/sha256"},
    "target_distribution_path": {"$ref": "#/$defs/relativePath"}, "target_distribution_sha256": {"$ref": "#/$defs/sha256"},
    "utility_anchors_path": {"$ref": "#/$defs/relativePath"}, "utility_anchors_sha256": {"$ref": "#/$defs/sha256"},
    "power_analysis_path": {"$ref": "#/$defs/relativePath"}, "power_analysis_sha256": {"$ref": "#/$defs/sha256"},
    "minimum_calibration_cases": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "robustness_pairs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/robustnessPair"}},
    "analysis_sha256": {"$ref": "#/$defs/sha256"},
    "sealed_access_policy_path": {"$ref": "#/$defs/relativePath"}, "sealed_access_policy_sha256": {"$ref": "#/$defs/sha256"},
    "sealed_content_disclosed": {"const": false},
    "commitment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*[/]\\.{1,2}(?:/|$))\\S(?:.*\\S)?$"
    },
    "caseCommitment": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "stratum_id", "critical", "task_path", "task_sha256", "scoring_anchor_path", "scoring_anchor_sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"}, "stratum_id": {"$ref": "#/$defs/identifier"},
        "critical": {"type": "boolean"},
        "task_path": {"$ref": "#/$defs/relativePath"}, "task_sha256": {"$ref": "#/$defs/sha256"},
        "scoring_anchor_path": {"$ref": "#/$defs/relativePath"}, "scoring_anchor_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "robustnessPair": {
      "type": "object", "additionalProperties": false,
      "required": ["clean_case_id", "perturbed_case_id"],
      "properties": {
        "clean_case_id": {"$ref": "#/$defs/identifier"},
        "perturbed_case_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
