{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-performance-engine:schema:frontier:release-policy:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_id", "primary_budget_dimension",
    "required_strong_baseline_ids", "required_strong_baseline_kinds",
    "required_judge_count", "require_judge_family_independence",
    "require_judge_provider_independence", "require_dual_position",
    "allowed_authority_routes", "human_gold", "statistical_design", "analysis",
    "policy_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"$ref": "#/$defs/identifier"},
    "primary_budget_dimension": {"enum": ["calls", "input_tokens", "output_tokens", "money_microunits", "wall_clock_ms"]},
    "required_strong_baseline_ids": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "required_strong_baseline_kinds": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["identity", "no_op", "expert", "random_search", "public_optimizer"]}
    },
    "required_judge_count": {"type": "integer", "minimum": 2, "maximum": 9007199254740991},
    "require_judge_family_independence": {"const": true},
    "require_judge_provider_independence": {"const": true},
    "require_dual_position": {"const": true},
    "allowed_authority_routes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["deterministic", "r05_docker", "r06_visual", "environment_state"]}
    },
    "human_gold": {"$ref": "#/$defs/humanGoldPolicy"},
    "statistical_design": {"$ref": "#/$defs/statisticalDesign"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "policy_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*[/]\\.{1,2}(?:/|$))\\S(?:.*\\S)?$"
    },
    "ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "humanGoldPolicy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ordinary_minimum_expert_reviewers", "critical_minimum_expert_reviewers",
        "require_senior_adjudication", "minimum_calibration_cases",
        "minimum_order_consistency_ppm", "minimum_human_majority_agreement_ppm",
        "minimum_agreement_coefficient_ppm", "minimum_critical_recall_ppm",
        "maximum_false_negative_rate_ppm", "maximum_length_bias_ppm"
      ],
      "properties": {
        "ordinary_minimum_expert_reviewers": {"type": "integer", "minimum": 2, "maximum": 9007199254740991},
        "critical_minimum_expert_reviewers": {"type": "integer", "minimum": 3, "maximum": 9007199254740991},
        "require_senior_adjudication": {"const": true},
        "minimum_calibration_cases": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "minimum_order_consistency_ppm": {"$ref": "#/$defs/ppm"},
        "minimum_human_majority_agreement_ppm": {"$ref": "#/$defs/ppm"},
        "minimum_agreement_coefficient_ppm": {"$ref": "#/$defs/ppm"},
        "minimum_critical_recall_ppm": {"$ref": "#/$defs/ppm"},
        "maximum_false_negative_rate_ppm": {"$ref": "#/$defs/ppm"},
        "maximum_length_bias_ppm": {"$ref": "#/$defs/ppm"}
      }
    },
    "statisticalDesign": {
      "type": "object", "additionalProperties": false,
      "required": [
        "primary_metric", "minimum_meaningful_effect_ppm",
        "minimum_detectable_effect_ppm", "confidence_level_ppm",
        "power_target_ppm", "tie_policy", "missing_observation_policy",
        "stopping_rule_path", "stopping_rule_sha256"
      ],
      "properties": {
        "primary_metric": {"$ref": "#/$defs/identifier"},
        "minimum_meaningful_effect_ppm": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "minimum_detectable_effect_ppm": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "confidence_level_ppm": {"type": "integer", "minimum": 500000, "maximum": 999999},
        "power_target_ppm": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "tie_policy": {"enum": ["zero_delta", "half_credit", "human_adjudication"]},
        "missing_observation_policy": {"const": "terminal_failure"},
        "stopping_rule_path": {"$ref": "#/$defs/relativePath"},
        "stopping_rule_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["bootstrap_seed", "bootstrap_iterations", "multiplicity_method", "percentile_method", "pareto_rule", "safety_event_unit", "safety_event_limit"],
      "properties": {
        "bootstrap_seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "bootstrap_iterations": {"type": "integer", "minimum": 1000, "maximum": 9007199254740991},
        "multiplicity_method": {"const": "holm"}, "percentile_method": {"const": "type_7"},
        "pareto_rule": {"const": "strict_non_dominated"}, "safety_event_unit": {"const": "distinct_case"},
        "safety_event_limit": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
