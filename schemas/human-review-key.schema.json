{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/prompt-performance/2.0.0/human-review-key.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_id",
    "authority",
    "protocol",
    "packet_sha256",
    "items",
    "key_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "authority": {"$ref": "#/$defs/authority"},
    "protocol": {"$ref": "#/$defs/protocol"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "key_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sample_size",
        "seed",
        "position_probe_count",
        "blinding_key"
      ],
      "properties": {
        "name": {"const": "balanced_round_robin_hmac_sha256_v3"},
        "sample_size": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "position_probe_count": {"type": "integer", "minimum": 2},
        "blinding_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicate_report_sha256",
        "suite_id",
        "benchmark_definition_sha256",
        "evaluation_sha256s"
      ],
      "properties": {
        "replicate_report_sha256": {"$ref": "#/$defs/sha256"},
        "suite_id": {"type": "string", "minLength": 1},
        "benchmark_definition_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "case_id",
        "domain",
        "case_sha256",
        "source_evaluation_sha256",
        "base_item_id",
        "position_probe",
        "optimized_label"
      ],
      "properties": {
        "item_id": {"type": "string", "pattern": "^review:[a-f0-9]{64}$"},
        "case_id": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "case_sha256": {"$ref": "#/$defs/sha256"},
        "source_evaluation_sha256": {"$ref": "#/$defs/sha256"},
        "base_item_id": {"type": "string", "pattern": "^case:[a-f0-9]{64}$"},
        "position_probe": {"type": "boolean"},
        "optimized_label": {"enum": ["A", "B"]}
      }
    }
  }
}
