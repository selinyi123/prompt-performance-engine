{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/prompt-performance/2.0.0/human-review-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_id",
    "authority",
    "protocol",
    "instructions",
    "items",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "authority": {"$ref": "#/$defs/authority"},
    "protocol": {"$ref": "#/$defs/protocol"},
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["winner_values", "blind", "minimum_reason_characters"],
      "properties": {
        "winner_values": {"const": ["A", "B", "tie"]},
        "blind": {"const": true},
        "minimum_reason_characters": {"const": 20}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "packet_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sample_size", "blinding_key_sha256"],
      "properties": {
        "name": {"const": "balanced_round_robin_hmac_sha256_v3"},
        "sample_size": {"type": "integer", "minimum": 1},
        "blinding_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicate_report_sha256",
        "suite_id",
        "benchmark_definition_sha256",
        "evaluation_sha256s"
      ],
      "properties": {
        "replicate_report_sha256": {"$ref": "#/$defs/sha256"},
        "suite_id": {"type": "string", "minLength": 1},
        "benchmark_definition_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "input_text",
        "rubric",
        "output_a",
        "output_b"
      ],
      "properties": {
        "item_id": {"type": "string", "pattern": "^review:[a-f0-9]{64}$"},
        "input_text": {"type": "string", "minLength": 1},
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "output_a": {"type": "string", "minLength": 1},
        "output_b": {"type": "string", "minLength": 1}
      }
    }
  }
}
